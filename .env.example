# HartsOfflineToolkit (Windows 10/11) Configuration
MODEL_PATH=
CPU_AFFINITY_CORES=0,1,2
CPU_WORKER_THREADS=3
WIN_PRIORITY_MODE=below_normal
MATRYOSHKA_DIM=256
RRF_K=60
LANCEDB_PATH=./data/db
DATA_INGEST_PATH=./data/raw

# Chunking, Batching & Security Guardrails
CHUNK_WORDS=400
CHUNK_OVERLAP_WORDS=50
EMBED_BATCH_SIZE=16
MAX_FILE_BYTES=52428800
MAX_CHUNKS_PER_DOC=500

# Optional: Set to 1 to disable MCP index_vault mutations
MCP_READ_ONLY=0
